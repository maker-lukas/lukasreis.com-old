---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FarmattedDate.astro';

const posts = (await getCollection('blog'))
    .filter(post => !post.data.draft)
    .sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );
---

{posts.length === 0 && <p class="empty">No posts yet :(</p>}

{posts.map((post) => (
    <div class="post-card">
        <span></span>
        <div class="data">
            <div>
                <h1 class="title">{post.data.title}</h1>
                <p class="description">{post.data.description}</p>
            </div>
            <p class="meta">
                <span class="date-line">Published on <FormattedDate date={post.data.pubDate} /></span>
                <a href={`/blog/${post.id}`} class="mobile-read"><span class="desktop">Read Post →</span><span class="mobile">Read →</span></a>
            </p>
        </div>
        <div class="read-post">
            <a href={`/blog/${post.id}`}><span class="desktop">Read Post →</span><span class="mobile">Read →</span></a>
        </div>
    </div>
))}

<style>
    .data {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .post-card {
        background-color:#7550A1;
        border-radius: 10px;
        padding: 15px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
    }

    a {
        font-size: 18px;
        font-weight: bold;
        color: white;
        width: fit-content;
    }

    .desktop,
    .mobile {
        display: inline;
        line-height: 1;
        vertical-align: baseline;
    }

    .mobile {
        display: none;
    }

    .mobile-read {
        display: none;
        margin-top: 8px;
    }

    h1 {
        font-size: 20px;
    }

    .read-post {
        text-align: end;
        width: fit-content;
        justify-self: end;
    }

    @media (max-width: 700px) {
        .post-card {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 15px;
        }

        .data {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .data > div {
            margin: 0;
        }

        .desktop {
            display: none;
        }

        .mobile {
            display: inline;
        }

        .meta {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            font-size: 15px;
            margin: 0;
            margin-top: auto;
        }

        .date-line {
            white-space: nowrap;
        }

        .mobile-read {
            display: block;
            width: fit-content;
            margin: 8px auto 0 auto;
        }

        .title {
            font-size: 18px;
            margin: 0;
        }

        .description {
            font-size: 15px;
            margin: 0;
        }

        .read-post {
            display: none;
        }
    }

</style>
